# Database
DATABASE_URL="postgresql://user:password@localhost:5432/pitchroom?schema=public"

# OpenAI API (for AI Sharks)
OPENAI_API_KEY="sk-..."
OPENAI_API_BASE="https://api.openai.com/v1"  # Optional: custom endpoint for OpenAI-compatible APIs (e.g., LM Studio, LocalAI, etc.)

# Text-to-Speech Providers (choose one or multiple)
# AssemblyAI - Primarily for transcription, has Lemur API
ASSEMBLYAI_API_KEY="your-assemblyai-key-here"

# ElevenLabs - Premium TTS with voice cloning (Recommended for production)
# ELEVENLABS_API_KEY="your-elevenlabs-key"

# OpenAI TTS - Simple, cost-effective TTS
# Uses OPENAI_API_KEY above, no separate key needed

# Alternative TTS Providers
# PLAY_HT_API_KEY="your-playht-key"
# AZURE_SPEECH_KEY="your-azure-key"
# AZURE_SPEECH_REGION="eastus"

# App Configuration
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: TTS Provider Selection
TTS_PROVIDER="openai"  # Options: openai, elevenlabs, assemblyai
